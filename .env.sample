DATABASE_URL=<<DATABASE_URL>>
NEON_AUTH_BASE_URL=<<NEON_AUTH_BASE_URL>>
NEON_AUTH_JWKS_URL=<<NEON_AUTH_JWKS_URL>>
PORT=4000

# Comma-separated browser origins allowed to call this API. The web app origin
# must be listed with NO trailing slash, for example:
# CORS_ORIGIN=https://finflow-frontend-mu.vercel.app,http://localhost:3000
# Use * only when you really want to accept every origin (bearer tokens are
# still required for every data route).
CORS_ORIGIN=<<CORS_ORIGIN>>
