{
  "name": "finflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FinFlow expense tracker API (Express + Neon Postgres)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "keywords": [
    "finflow",
    "expense-tracker",
    "neon",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
